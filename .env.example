# ============================================
# TryMyPost — variáveis de ambiente (exemplo)
# Copie para .env e preencha com valores reais.
# O arquivo .env não deve ser commitado.
# ============================================

# ---- Provedores de IA (obrigatório) ----
GOOGLE_API_KEY=your_google_gemini_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here

# ---- JWT ----
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# ---- Banco de dados (app) ----
# No docker-compose o backend usa a URL do serviço `vectordb` (definida no compose).
DATABASE_URL=postgresql+asyncpg://trymypost:trymypost@localhost:5433/trymypost

# ---- Banco vetorial (RAG) ----
VECTOR_DATABASE_URL=postgresql+asyncpg://trymypost:trymypost@localhost:5433/trymypost_rag
GOOGLE_EMBEDDING_MODEL=models/gemini-embedding-002

# ---- Fila de mensagens ----
# Execução local (fora do docker): localhost. No compose, o backend/worker
# recebe RABBITMQ_URL via `environment:` com o hostname interno.
RABBITMQ_URL=amqp://trymypost:trymypost@localhost:5672/
RABBITMQ_USER=trymypost
RABBITMQ_PASSWORD=trymypost

# ---- Redis (cache/filas auxiliares) ----
REDIS_URL=redis://localhost:6379/0

# ---- MinIO (armazenamento de mídia) ----
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET=trymypost

# ---- pgAdmin (lido pelo docker-compose) ----
PGADMIN_DEFAULT_EMAIL=admin@trymypost.dev
PGADMIN_DEFAULT_PASSWORD=trymypost

# ---- Geral ----
DEBUG=true
